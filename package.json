{
  "name": "puzzle-hunt-workbench",
  "version": "0.1.3",
  "private": true,
  "description": "Desktop puzzle-hunt workspace with multi-tab puzzle browsing, a persistent canvas, sleeping tools, and safe offline puzzle snapshots.",
  "author": "Puzzle Hunt Workbench contributors",
  "main": "src/main-v012.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.js",
    "check": "node scripts/check-source.js && npm test",
    "dist": "npm run check && node scripts/package-current-platform.js",
    "dist:dir": "npm run check && electron-builder --dir --publish never"
  },
  "devDependencies": {
    "electron": "43.2.0",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "app.puzzlehunt.workbench",
    "productName": "Puzzle Hunt Workbench",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Puzzle-Hunt-Workbench-${version}-Windows-Setup.${ext}"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "artifactName": "Puzzle-Hunt-Workbench-${version}-macOS-Portable-${arch}.${ext}",
      "category": "public.app-category.productivity"
    },
    "dmg": {
      "artifactName": "Puzzle-Hunt-Workbench-${version}-macOS-DMG-${arch}.${ext}"
    },
    "linux": {
      "target": ["AppImage", "tar.gz"],
      "artifactName": "Puzzle-Hunt-Workbench-${version}-Linux-Portable-${arch}.${ext}",
      "category": "Utility"
    }
  }
}
